[Unit]
Description=GlobaLeaks Whistleblowing Software
After=remote-fs.target
After=network-online.target
After=nss-lookup.target
After=time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=globaleaks
Group=globaleaks
Restart=on-failure
RestartPreventExitStatus=78
TimeoutSec=5min
KillMode=mixed

EnvironmentFile=-/usr/share/globaleaks/default
EnvironmentFile=-/etc/default/globaleaks

ExecStartPre=+/usr/lib/globaleaks/globaleaks-firewall start
ExecStart=/usr/lib/globaleaks/globaleaks-exec
ExecStopPost=+/usr/lib/globaleaks/globaleaks-firewall stop

RuntimeDirectory=globaleaks
RuntimeDirectoryMode=0700

# Process
NoNewPrivileges=yes
LockPersonality=yes
MemorySwapMax=0
UMask=0027
CapabilityBoundingSet=

# Filesystem
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/globaleaks
PrivateTmp=yes
PrivateDevices=yes
# Give the service a private, empty /dev/shm so the ramdisk lives in its own
# namespace and no local user can pre-plant entries there. PrivateTmp= only
# isolates /dev/shm on systemd >= 257; this works on all supported releases.
# mode=1777 lets the unprivileged daemon create its own subdirectory.
TemporaryFileSystem=/dev/shm:mode=1777

# Kernel
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
ProtectProc=invisible
RemoveIPC=yes

# Namespaces
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

# Syscalls and sockets
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
