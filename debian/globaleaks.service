[Unit]
Description=LSB: Start the GlobaLeaks server.
After=remote-fs.target
After=network-online.target
After=nss-lookup.target
After=time-sync.target

[Service]
Type=forking
Restart=on-failure
TimeoutSec=5min
KillMode=process
RemainAfterExit=yes
ExecStart=/etc/init.d/globaleaks start
ExecStop=/etc/init.d/globaleaks stop
ExecReload=/etc/init.d/globaleaks reload
PIDFile=/run/globaleaks/globaleaks.pid

MemorySwapMax=0
NoNewPrivileges=yes
SystemCallArchitectures=native
LockPersonality=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/globaleaks
UMask=0027

[Install]
WantedBy=multi-user.target
Alias=globaleaks.service
