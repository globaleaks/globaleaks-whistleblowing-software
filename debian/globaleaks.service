[Unit]
Description=GlobaLeaks Whistleblowing Software
After=remote-fs.target
After=network-online.target
After=nss-lookup.target
After=time-sync.target

[Service]
Type=simple
User=globaleaks
Group=globaleaks
Restart=on-failure
RestartPreventExitStatus=78
TimeoutSec=5min
KillMode=mixed

EnvironmentFile=-/usr/share/globaleaks/default
EnvironmentFile=-/etc/default/globaleaks

ExecStartPre=+/usr/lib/globaleaks/globaleaks-firewall start
ExecStart=/usr/lib/globaleaks/globaleaks-exec
ExecStopPost=+/usr/lib/globaleaks/globaleaks-firewall stop

RuntimeDirectory=globaleaks
RuntimeDirectoryMode=0700

MemorySwapMax=0
NoNewPrivileges=yes
SystemCallArchitectures=native
LockPersonality=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# Give the service a private, empty /dev/shm so the ramdisk lives in its own
# namespace and no local user can pre-plant entries there. PrivateTmp= only
# isolates /dev/shm on systemd >= 257; this works on all supported releases.
# mode=1777 lets the unprivileged daemon create its own subdirectory.
TemporaryFileSystem=/dev/shm:mode=1777
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/globaleaks
UMask=0027

[Install]
WantedBy=multi-user.target
