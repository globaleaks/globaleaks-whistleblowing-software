#!/bin/sh
# This is the pre installation script for globaleaks
set -e

#DEBHELPER#

# Disable the system tor service; GlobaLeaks manages its own tor instance
systemctl disable tor 2>/dev/null || true
systemctl stop tor 2>/dev/null || true

if [ "$1" = "upgrade" ]; then
  service globaleaks stop || true

  # Drop the link of an alias of the unit to itself, that shadows the unit
  # shipped by the package
  link=/etc/systemd/system/globaleaks.service
  if [ -L "$link" ]; then
    case "$(readlink "$link")" in
      */globaleaks.service) rm -f "$link" ;;
    esac
  fi
fi
